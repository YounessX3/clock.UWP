<Page
    x:Class="clock.UWP.StopwatchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:clock.UWP"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Reuse the same button style -->
        <Style x:Key="SquareButton" TargetType="Button">
            <Setter Property="Padding" Value="25,12"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="MinHeight" Value="60"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Large Stopwatch Display -->
        <Style x:Key="LargeDisplay" TargetType="TextBlock">
            <Setter Property="FontSize" Value="48"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Padding="20">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="540">
            <!-- Stopwatch Display -->
            <TextBlock x:Name="StopwatchDisplay" Style="{StaticResource LargeDisplay}" Text="00:00:00.00" />

            <!-- Stopwatch Control Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button x:Name="StartStopwatchBtn" Content="Start" Click="StartStopwatchBtn_Click" Style="{StaticResource SquareButton}" />
                <Button x:Name="LapBtn" Content="Lap" Click="LapBtn_Click" Style="{StaticResource SquareButton}" Margin="10,0,0,0"/>
                <Button x:Name="ResetStopwatchBtn" Content="Reset" Click="ResetStopwatchBtn_Click" Style="{StaticResource SquareButton}" Margin="10,0,0,0"/>
            </StackPanel>

            <!-- Laps List -->
            <ListView x:Name="LapsListView" Margin="0,20,0,0" Height="240"/>
        </StackPanel>
    </Grid>
</Page>
