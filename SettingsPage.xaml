<Page
    x:Class="clock.UWP.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Padding="20">

    <ScrollViewer>
        <StackPanel Padding="20" Spacing="24">

            <TextBlock Text="Settings" FontSize="32" FontWeight="SemiBold" />

            <!-- Theme selection -->
            <StackPanel>
                <TextBlock Text="Theme" FontSize="18" Margin="0,0,0,8"/>
                <ComboBox x:Name="ThemeComboBox" Width="200" SelectionChanged="ThemeComboBox_SelectionChanged">
                    <ComboBoxItem Content="System Default" />
                    <ComboBoxItem Content="Light" />
                    <ComboBoxItem Content="Dark" />
                </ComboBox>
            </StackPanel>

            <!-- App version display -->
            <StackPanel>
                <TextBlock Text="App Version" FontSize="18" Margin="0,20,0,4"/>
                <TextBlock x:Name="AppVersionTextBlock" FontSize="16" Foreground="Gray"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
