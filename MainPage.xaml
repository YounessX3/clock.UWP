<Page
    x:Class="clock.UWP.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:clock.UWP"
    RequestedTheme="Default"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <AcrylicBrush x:Key="NavigationViewExpandedPaneBackground"
                                  BackgroundSource="HostBackdrop"
                                  TintColor="#CCFFFFFF"
                                  TintOpacity="0.6"
                                  FallbackColor="#F2F2F2"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <AcrylicBrush x:Key="NavigationViewExpandedPaneBackground"
                                  BackgroundSource="HostBackdrop"
                                  TintColor="#CC000000"
                                  TintOpacity="0.6"
                                  FallbackColor="#1F1F1F"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <NavigationView
        x:Name="NavView"
        ItemInvoked="NavView_ItemInvoked"
        IsBackButtonVisible="Collapsed"
        PaneDisplayMode="Auto"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <NavigationView.MenuItems>
            <!-- Timer -->
            <NavigationViewItem x:Name="TimerNavItem" Content="Timer" Tag="timer">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE823;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <!-- Stopwatch -->
            <NavigationViewItem x:Name="StopwatchNavItem" Content="Stopwatch" Tag="stopwatch">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE916;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <!-- Frame for content -->
        <Frame x:Name="ContentFrame" Margin="6">
            <Frame.ContentTransitions>
                <TransitionCollection>
                    <NavigationThemeTransition/>
                </TransitionCollection>
            </Frame.ContentTransitions>
        </Frame>
    </NavigationView>
</Page>
