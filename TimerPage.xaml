<Page
    x:Class="clock.UWP.TimerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:clock.UWP"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Button Style -->
        <Style x:Key="SquareButton" TargetType="Button">
            <Setter Property="Padding" Value="25,12"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="MinHeight" Value="60"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Large Timer Display -->
        <Style x:Key="LargeDisplay" TargetType="TextBlock">
            <Setter Property="FontSize" Value="48"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Padding="20">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
            <!-- Timer Display -->
            <TextBlock x:Name="TimerDisplay" Style="{StaticResource LargeDisplay}" Text="00:00:00" />

            <!-- Time Input -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <TextBox x:Name="MinutesInput" Width="70" PlaceholderText="MM" Text="0" HorizontalContentAlignment="Center"/>
                <TextBox x:Name="SecondsInput" Width="70" PlaceholderText="SS" Text="0" Margin="10,0,0,0" HorizontalContentAlignment="Center"/>
            </StackPanel>

            <!-- Timer Control Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button x:Name="StartStopBtn" Content="Start" Click="StartStopBtn_Click" Style="{StaticResource SquareButton}" />
                <Button x:Name="ResetTimerBtn" Content="Reset" Click="ResetTimerBtn_Click" Style="{StaticResource SquareButton}" Margin="10,0,0,0"/>
            </StackPanel>

            <!-- Timer State Text -->
            <TextBlock x:Name="TimerStateText" Text="" HorizontalAlignment="Center" Margin="0,12,0,0" />
        </StackPanel>
    </Grid>
</Page>
